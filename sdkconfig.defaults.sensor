# ESP-LEGO sensor submodule firmware defaults
CONFIG_DEVICE_ROLE_SENSOR=y
# CONFIG_DEVICE_ROLE_MASTER is not set

# Sensor firmware doesn't need Web Console
# CONFIG_WEB_CONSOLE_ENABLED is not set

# Sensor identity (auto = use MAC address last byte, unique per chip)
# Override these if you need fixed IDs for specific locations:
#   CONFIG_SENSOR_MODULE_ID=10
#   CONFIG_SENSOR_MODULE_NAME="kitchen_temp"
CONFIG_SENSOR_MODULE_ID=0
CONFIG_SENSOR_MODULE_NAME=""
