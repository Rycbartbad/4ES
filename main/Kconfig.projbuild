menu "ESP-LEGO Device Role"

choice DEVICE_ROLE
    prompt "Device role"
    default DEVICE_ROLE_MASTER
    help
        Select the firmware role for this ESP32-S3 board.
        Master: full script interpreter + ESP-NOW peer manager.
        Sensor: lite ESP-NOW slave (announce + command response).

config DEVICE_ROLE_MASTER
    bool "Master (interpreter + ESP-NOW manager)"

config DEVICE_ROLE_SENSOR
    bool "Sensor (ESP-NOW slave)"

endchoice

config SENSOR_MODULE_NAME
    string "Sensor module name"
    default "sensor"
    depends on DEVICE_ROLE_SENSOR
    help
        Human-readable name broadcast in announce packets.
        Master uses this to present module info in list_peers().
        Example: "kitchen_temp", "living_light", "garden_moisture"

config DOORBELL_PIN
    int "Doorbell input GPIO"
    default 35 if IDF_TARGET_ESP32S3
    default 4 if IDF_TARGET_ESP32C3
    range 0 48
    depends on DEVICE_ROLE_SENSOR
    help
        GPIO used as the doorbell input. ESP32-C3 builds cannot use the
        ESP32-S3-only GPIO35 default, so they default to GPIO4.

config DOORBELL_ACTIVE_LEVEL
    int "Doorbell active level"
    default 1
    range 0 1
    depends on DEVICE_ROLE_SENSOR
    help
        Logic level treated as pressed.

config BUZZER_PIN
    int "Doorbell buzzer GPIO"
    default 36 if IDF_TARGET_ESP32S3
    default 5 if IDF_TARGET_ESP32C3
    range 0 48
    depends on DEVICE_ROLE_SENSOR
    help
        GPIO used for the passive buzzer PWM output. ESP32-C3 builds
        default to GPIO5.

endmenu
