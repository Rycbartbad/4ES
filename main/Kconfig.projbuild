menu "ESP-LEGO Device Role"

choice DEVICE_ROLE
    prompt "Device role"
    default DEVICE_ROLE_MASTER
    help
        Select the firmware role for this ESP32-S3 board.
        Master: full script interpreter + ESP-NOW peer manager.
        Sensor: lite ESP-NOW slave (announce + command response).

config DEVICE_ROLE_MASTER
    bool "Master (interpreter + ESP-NOW manager)"

config DEVICE_ROLE_SENSOR
    bool "Sensor (ESP-NOW slave)"

endchoice

config SENSOR_MODULE_NAME
    string "Sensor module name"
    default "sensor"
    depends on DEVICE_ROLE_SENSOR
    help
        Human-readable name broadcast in announce packets.
        Master uses this to present module info in list_peers().
        Example: "kitchen_temp", "living_light", "garden_moisture"

choice SENSOR_ACQUISITION_PROFILE
    prompt "Sensor acquisition profile"
    default SENSOR_ACQUISITION_NONE
    depends on DEVICE_ROLE_SENSOR
    help
        Select the physical sensor read by this submodule.

config SENSOR_ACQUISITION_NONE
    bool "Generic ADC / no dedicated sensor"

config SENSOR_ACQUISITION_BH1750
    bool "BH1750 ambient light sensor (I2C)"

endchoice

config BH1750_SDA_GPIO
    int "BH1750 SDA GPIO"
    default 8
    range 0 48
    depends on SENSOR_ACQUISITION_BH1750

config BH1750_SCL_GPIO
    int "BH1750 SCL GPIO"
    default 9
    range 0 48
    depends on SENSOR_ACQUISITION_BH1750

choice SENSOR_ACTUATOR_PROFILE
    prompt "Actuator profile"
    default SENSOR_ACTUATOR_BUZZER
    depends on DEVICE_ROLE_SENSOR
    help
        Select at most one actuator driver for this submodule build.
        Sensor acquisition profiles remain unchanged.

config SENSOR_ACTUATOR_NONE
    bool "No actuator"

config SENSOR_ACTUATOR_BUZZER
    bool "Passive buzzer"

config SENSOR_ACTUATOR_SERVO
    bool "Hobby servo"

config SENSOR_ACTUATOR_PUMP
    bool "Timed water pump"

endchoice

config PUMP_GPIO
    int "Pump control GPIO"
    default 10
    range 0 48
    depends on SENSOR_ACTUATOR_PUMP

config PUMP_ACTIVE_HIGH
    bool "Pump output is active-high"
    default y
    depends on SENSOR_ACTUATOR_PUMP

config PUMP_MAX_RUN_MS
    int "Maximum pump run time per command (ms)"
    default 30000
    range 1 30000
    depends on SENSOR_ACTUATOR_PUMP

endmenu
